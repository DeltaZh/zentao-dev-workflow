{
  "baseUrl": "https://zentao.example.com",
  "account": "your_account",
  "password": "your_password",
  "defaults": {
    "storyCategory": "feature",
    "confirmBeforeWrite": true,
    "doNotChangeProjectStatus": true
  },
  "policy": {
    "hourMethod": "senior_by_volume_and_difficulty",
    "titleStyle": "verb_result",
    "titleStyleNote": "",
    "allowReadOthersTasks": true,
    "allowModifyOthersTasks": false,
    "requirePreview": true,
    "previewSurface": "canvas",
    "repoLock": "session_git_root",
    "assignToSelf": true,
    "serverUtcOffsetHours": 8,
    "writeIntervalSeconds": 0.35,
    "authRetries": 2,
    "authBackoffSeconds": 0.5
  },
  "statusMap": {
    "storyAfterCreate": "active",
    "taskAfterFinish": "done",
    "storyAfterFinishPartial": "developing",
    "storyAfterFinishAll": "developed"
  },
  "repos": {}
}
